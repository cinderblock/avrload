{
  "name": "avrload",
  "version": "1.0.0",
  "description": "Prepare AVR flash buffers from Intel HEX files, and program them over serial using the DanceBoot bootloader protocol.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/avrload.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/avrload.git"
  },
  "keywords": [
    "avr",
    "atmega",
    "attiny",
    "flash",
    "ihex",
    "intel-hex",
    "bootloader",
    "danceboot",
    "rs485",
    "serial",
    "firmware"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cinderblock/avrload/issues"
  },
  "homepage": "https://github.com/cinderblock/avrload#readme",
  "dependencies": {
    "crc": "^4.3.2",
    "ihex": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  }
}
